# Бекапи редакторів/перекодувальників: файл-копія з «~» у кінці імені.
# Реальний випадок 01.10.2026: сторонній процес перезаписував фони студії
# (src/assets/backgrounds/*.webp) lossless-кодеком і лишав поруч копію з «~»;
# без цього правила вони поїхали б у коміт як сміття.
*~

# згенеровані зображення
assets/generated/

# серверні дані (користувачі, сесії, витрати) — лише коренева тека.
# Без початкового "/" gitignore зіставляє "data/" з теку такою назвою на
# БУДЬ-ЯКІЙ глибині — це випадково ховало й src/data/ (вихідний код:
# initialBook.ts, mastery18.ts, skillMarkers.ts, skillsData.ts) від git,
# і збірка не могла зібратися з чистого клону репозиторію.
/data/
designcraft-work/

# Ключі та інший секретний матеріал — НІКОЛИ не в репозиторій.
# 20.10.2026 приватний ssh-ключ потрапив у коміт через `git add -A`:
# його згенерували в теці репозиторію, бо ~/.ssh тоді не існувало.
# Коміт не був запушений і його прибрано, але правило лишається.
sshkey*
id_ed25519*
id_rsa*
*.pem
*.ppk
