/** Reproducible source manuscript; render/publish it with Studio's normal book APIs. */
import fs from 'node:fs';
import path from 'node:path';
import { initialBook } from '../src/data/initialBook';

const out = process.env.TABLE_GUIDE_OUTPUT || '/workspace/artifacts/table-guide';
fs.mkdirSync(out, { recursive: true });
const chapters = [
  ['Почніть із задуму', `Ця інструкція допоможе створити власний стіл із дерев’яних слебів та епоксидної смоли у Fusion Lab. Конструктор відкривається без реєстрації за адресою https://www.fusionlab.in.ua/table-builder. Для оформлення замовлення увійдіть у свій акаунт.

Визначте місце встановлення, форму та потрібні розміри. Виміряйте вільний простір і врахуйте проходи та місце для стільців. У конструкторі всі розміри задаються в сантиметрах.

Фотографії готових столів у лендінгу показують можливі композиції. Для свого виробу ви обираєте конкретні заготовки зі складу: їхні контури, пропорції та розміри відповідають слебам, підготовленим майстернею.

Відкрийте конструктор кнопкою «Створити свій стіл» у блоці під товарами головної сторінки. На сторінці конструктора також доступний цей безкоштовний PDF.`],
  ['1. Задайте форму та розміри', `У блоці «Параметри столу» оберіть форму: квадрат, коло або овал. Для квадрата введіть сторону, для кола — діаметр, для овала — довжину й ширину. Значення можна змінювати безпосередньо з клавіатури; полотно оновлюється під час введення.

Доступні межі: сторона квадрата або діаметр кола — від 40 до 180 см; довжина овала — від 40 до 350 см, ширина — від 40 до 180 см. Товщина стільниці — від 1 до 15 см. Наприклад, для овального столу можна задати 180 × 90 см і товщину 4 см.

Під час очищення поля ви можете спочатку ввести нове число. Якщо значення порожнє або виходить за допустимі межі, розрахунок тимчасово недоступний. Виправте поле, щоб продовжити.

Зміна розміру стільниці не збільшує сам слеб: деревина залишається у своїх фізичних розмірах. Так можна побачити, скільки матеріалу потрапить у вибрану форму.`],
  ['2. Оберіть справжні слеби', `Нижче полотна розташована бібліотека доступних слебів. Скористайтеся фільтрами породи: дуб, ясен, горіх, каповий тополь, бук або «Усі породи». Нуль біля назви означає, що зараз таких заготовок немає у вибірці. Також можна відбирати слеби за довжиною та шириною.

На картці перевірте номер слеба, фотографію та розміри. Натисніть «+», щоб додати заготовку на стільницю. Покупець використовує вже завантажені майстернею слеби й не повинен самостійно обводити їх або налаштовувати масштаб.

Кожний слеб є окремою заготовкою. Один і той самий слеб не додається двічі. Вибирайте за фотографією саме той малюнок деревини, який хочете бачити у виробі.

Товщина слебів має відповідати товщині стільниці. Якщо конструктор повідомляє про невідповідність, оберіть сумісні заготовки або узгодьте товщину перед розрахунком.`],
  ['3. Складіть композицію', `Перетягніть слеби мишкою або дотиком на 2D-полотні. Оберіть слеб, щоб змінювати його положення. У рядку заготовки під полотном можна точно задати координати X і Y у сантиметрах та поворот у градусах.

На комп’ютері вибраний слеб можна пересувати стрілками: крок — 1 см, разом із Shift — 5 см. Delete видаляє його з композиції. Також використовуйте кнопку «Видалити» біля слеба.

Залишайте потрібний проміжок між дерев’яними краями — це зона заливки смоли. Стежте, щоб слеби не перекривали один одного: фізично дві заготовки не можуть займати те саме місце.

Частини деревини за межами форми будуть обрізані. Контур стільниці показує готовий зовнішній край, а не повний розмір вихідної заготовки. Перевірте розташування сучків і природного краю перед погодженням.

Кнопка «Почати заново» очищає композицію. Використовуйте її, коли хочете створити інший варіант.`],
  ['4. Оберіть смолу та основу', `У параметрах столу виберіть колір епоксидної смоли. Якщо майстерня опублікувала готові текстури, їх можна обрати з каталогу. Текстура покриває зону смоли між слебами, зберігаючи видимою деревину.

Для власного вигляду натисніть «Завантажити текстуру смоли». Підтримуються PNG, JPG та WEBP розміром до 35 МБ. Система читає й автоматично стискає зображення; дочекайтеся завершення індикатора прогресу та повідомлення про готовність. Для швидкої роботи довга сторона зменшується до 2048 пікселів або нижче, якщо це потрібно для допустимого розміру файла.

Для повернення до суцільного кольору видаліть власну текстуру або виберіть колір знову. Дочекайтеся завершення обробки перед розрахунком ціни.

Оберіть варіант ніжок або основи з доступних у конструкторі. Їхня вартість входить у розрахунок відповідно до опублікованих тарифів майстерні. Екранний вигляд смоли є візуалізацією; відтінок готового матеріалу залежить від освітлення та виробничого виконання.`],
  ['5. Розрахуйте й погодьте вартість', `Перевірте форму, розміри, товщину, конкретні номери слебів, їхнє розташування, смолу й основу. Натисніть «Розрахувати вартість».

Розрахунок використовує реальну площу деревини всередині стільниці та обсяг проміжків для смоли. Застосовуються тарифи матеріалів і робіт, опубліковані адміністратором. Вартість смоли та інші виробничі витрати покупець не задає вручну.

Якщо тарифи ще не налаштовані, конструктор повідомить, що розрахунок недоступний. Не підставляйте власну випадкову ціну — зверніться до майстерні.

Після будь-якої зміни композиції попередню ціну потрібно розрахувати знову. Навіть якщо відповідь старого запиту прийшла із затримкою, вона не повинна погоджувати вже змінений стіл.

Прочитайте склад розрахунку, загальну суму й розмір передоплати. Погодьте вартість відповідною позначкою та додайте стіл у кошик як передзамовлення. До погодження ціни оформлення недоступне.`],
  ['6. Передзамовлення та корисні перевірки', `У кошику перевірте конфігурацію свого столу ще раз. Для запуску виробництва передбачена передоплата 50% вартості. Передавання у виробництво відбувається після належного підтвердження платежу системою. Саме натискання кнопки розрахунку або додавання в кошик не означає оплати.

Для нового варіанта поверніться у конструктор і заново розрахуйте змінену композицію. Перед підтвердженням переконайтеся, що обрані слеби залишаються доступними.

Якщо число не приймається: перевірте одиниці — потрібні сантиметри — та допустимі межі. Для кола й квадрата змінюється одне поле, оскільки їхні сторони рівні.

Якщо текстура не завантажується: перевірте формат та межу 35 МБ. Зачекайте завершення обробки; надто велике або пошкоджене зображення потрібно замінити.

Якщо ціна застаріла: завершіть усі зміни й натисніть розрахунок ще раз. Якщо слеб недоступний, оберіть іншу заготовку зі складу.

На телефоні можна прокручувати параметри й бібліотеку та пересувати заготовки дотиком. Для точного розташування використовуйте числові поля X, Y і повороту.`],
  ['Додаток для майстерні: підготовка слебів', `Адміністратор і користувач із роллю «Дизайнер меблів» працюють зі спільним складом. У маркетплейсі відкрийте /admin/slabs; у Студії — «Адмінпанель» → «Слеби та столи». Покупцеві цей доступ не потрібний.

Завантажте фотографію слеба зверху на контрастному фоні. Для фотографій слебів діє окрема межа 12 МБ; межа 35 МБ стосується текстур смоли.

Лінійкою позначте відрізок на фотографії та введіть його справжню довжину в сантиметрах. Після калібрування слеб має відображатися на стільниці у фізично правильних пропорціях. Запишіть номер, породу й товщину заготовки.

Перевірте автоматичну обводку. Якщо вона не відповідає краю деревини, обведіть слеб мишкою або стилусом і замкніть контур. Виправте відкриті чи некоректні ділянки до збереження. У контур має входити деревина конкретної заготовки.

Перевірений контур можна експортувати у SVG або DXF 2000 у міліметрах, масштаб 1:1. Перед використанням у CAD звірте контрольний розмір. Після збереження доступний слеб з’явиться в бібліотеці покупця.

Тарифи, публікація стандартних текстур і керування виробництвом належать адміністратору. Призначення та відкликання ролі дизайнера синхронізуються між обома адмінпанелями.`],
];
const book: any = structuredClone(initialBook);
Object.assign(book, {
  id: 'BK-TABLE-BUILDER-GUIDE',
  title: 'Конструктор епоксидного столу: інструкція покупця',
  subtitle: 'Від вибору слеба до передзамовлення',
  author: 'Адміністратор сайту Fusion Lab',
  language: 'uk',
  logline: 'Безкоштовний покроковий посібник зі створення власного столу в конструкторі Fusion Lab.',
  synopsis: 'Оберіть слеби зі складу, задайте форму та розміри, розмістіть деревину, оберіть смолу й основу, розрахуйте вартість та оформіть передзамовлення. Додаток пояснює підготовку слебів для адміністратора й дизайнера меблів.',
  characters: [], illustrations: [], coverDesign: undefined,
  chapters: chapters.map(([title, content], i) => ({
    id: `guide-ch-${i + 1}`, title, order: i + 1,
    sections: [{id: `guide-sec-${i + 1}`, chapterId: `guide-ch-${i + 1}`, title: '', content, order: 1, wordCount: content.split(/\s+/).length, lastModified: '2026-10-27T00:00:00Z'}],
  })),
});
book.layoutConfig = {
  formatPreset: 'A5', pageWidthMm: 148, pageHeightMm: 210,
  bookDesignThemeId: 'studio-editorial',
  margins: { topMm: 17, bottomMm: 18, insideMm: 16, outsideMm: 16, bleedMm: 0, mirrored: false },
  typography: { bodyFont: 'DejaVu Sans', headingsFont: 'DejaVu Sans', fontSizePt: 10.5, lineHeight: 1.4, firstLineIndentMm: 0, paragraphSpacingMm: 2, textAlign: 'left', pageNumberPosition: 'bottom-center', showHeaders: false },
  frontMatter: { showTitlePage: true, showCopyright: true, showDedication: false, showEpigraph: false, showTableOfContents: true, copyrightText: 'Fusion Lab · Безкоштовна інструкція · 27.10.2026\nАвтор: Адміністратор сайту Fusion Lab\nhttps://www.fusionlab.in.ua/table-builder' },
};
fs.writeFileSync(path.join(out, 'book.json'), JSON.stringify(book, null, 2));
fs.writeFileSync(path.join(out, 'instruction.md'), `# ${book.title}\n\n${book.subtitle}\n\nАвтор: ${book.author}\n\n` + chapters.map(([t, c]) => `## ${t}\n\n${c}`).join('\n\n'));
console.log(`Guide source: ${chapters.length} chapters, ${chapters.reduce((n, [, c]) => n + c.split(/\s+/).length, 0)} words.`);
