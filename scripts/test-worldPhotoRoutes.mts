import assert from 'node:assert/strict';
import {wizardHarness} from './lib/wizardHarness.mts';
const h=await wizardHarness();
const users=await import('../server/store'),books=await import('../server/bookStore');
const {registerSourceRoutes}=await import('../server/core/collaboration/sourceRoutes');
const {computeEffective}=await import('../server/core/collaboration/access');
const {acceptedAiText}=await import('../shared/aiTextOrigin');
let count=0,revoked=false;const check=(name:string,ok:unknown)=>{assert.ok(ok,name);count++;console.log('✓ '+name);};
try{
 for(const id of ['writer','other','disabled'])await users.saveUser({id,email:id+'@example.test',name:id,role:'writer',createdAt:new Date().toISOString(),disabled:id==='disabled'});
 const d=h.store.createDraft('writer',{navigationVersion:2,stepKey:'seed',seed:'Острів із кам’яною вежею для історії'});
 const world={id:'w',name:'Острів',description:'Кам’яна вежа',rules:'Час не повертається',notes:'PRIVATE_NOTES',approved:true};
 const worldDraft=h.store.updateDraft(d.id,{navigationVersion:2,storyWorld:world},d.revision,6)!;
 check('server resumes world by stable key without shifting cast step',worldDraft.step===6&&worldDraft.payload.stepKey==='world');
 const legacy=h.store.createDraft('writer',{seed:'Давня чернетка із героями'});
 const castDraft=h.store.updateDraft(legacy.id,{cast:[{id:'m',firstName:'Марта',lastName:'Лісова'}]},legacy.revision,3)!;
 const migrated=h.store.updateDraft(castDraft.id,{navigationVersion:2},castDraft.revision,3)!;
 check('legacy draft migration keeps cast and current step',migrated.payload.cast?.[0].id==='m'&&migrated.step===3&&migrated.payload.stepKey==='cast');
 const uploaded=await h.request('/api/media/upload','POST',{dataUrl:'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zl1kAAAAASUVORK5CYII=',filename:'tower.png',kind:'upload'});
 assert.equal(uploaded.status,200);
 const asset=uploaded.body.asset;
 const request={assetIds:[asset.id],modelId:'fixture-vision',target:'world',draftId:worldDraft.id,expectedRevision:worldDraft.revision};
 const call=(data:any=request,user='writer')=>h.request('/api/express/sources/describe-world','POST',data,user);
 let r=await call();
 check('photo returns separate facts, invention and unknown; canon untouched',r.status===200&&r.body.visible.includes('Кам’яна')&&r.body.creative.includes('Вигадка')&&r.body.approved===false&&h.store.getDraft(d.id)?.revision===worldDraft.revision);
 const generated=await h.media.saveAsset({ownerId:'writer',kind:'illustration',filename:'generated-tower.png',mimeType:'image/png',bytes:Buffer.from('fixture-image'),prompt:'fictional tower',model:'fixture-image',passport:{source:'ai'}});
 r=await call({...request,assetIds:[asset.id,generated.id]});
 check('uploaded and generated references work together without changing image origin',r.status===200&&r.body.assetIds.length===2&&(await h.media.getAsset(generated.id))?.source==='ai');
 const calls=h.state.worldDescriptions;
 check('guest cannot request analysis',(await call(request,'guest')).status===401);
 check('foreign account cannot analyze private image',(await call({...request,draftId:undefined,expectedRevision:undefined},'other')).status===403);
 check('disabled account rejected before provider',(await call(request,'disabled')).status===401);
 check('invalid intent and duplicate images rejected',(await call({...request,target:'secret'})).status===400&&(await call({...request,assetIds:[asset.id,asset.id]})).status===400);
 check('rejected requests do not reach provider',h.state.worldDescriptions===calls);
 check('stale draft revision rejected before provider',(await call({...request,expectedRevision:1})).status===409);
 h.state.beforeReply=async()=>{h.store.updateDraft(worldDraft.id,{genre:'Змінений жанр'},worldDraft.revision);h.state.beforeReply=null;};
 check('draft change while provider is running rejects late result',(await call()).status===409);
 const stored=await books.saveBook({ownerId:'writer',book:{id:'world-photo-book',title:'Книга',storyWorld:world,chapters:[{id:'c',sections:[{id:'allowed',content:acceptedAiText('Видимий уривок.','writer')},{id:'hidden',content:acceptedAiText('PRIVATE_HIDDEN_SCENE','writer')}]}]}});
 const bookRequest={assetIds:[asset.id],modelId:'fixture-vision',target:'setting',bookId:stored.id,sectionId:'allowed',expectedRevision:stored.revision};
 check('owner can describe scene against exact server revision',(await call(bookRequest)).status===200);
 check('foreign book and missing scene rejected',(await call(bookRequest,'other')).status===403&&(await call({...bookRequest,sectionId:'missing'})).status===404);
 h.state.beforeReply=async()=>{await books.saveBook({ownerId:'writer',book:stored.book,expectedRevision:stored.revision});h.state.beforeReply=null;};
 check('book CAS rejects late photo response',(await call(bookRequest)).status===409);
 const fresh=await books.getBook(stored.id);
 h.state.beforeReply=async()=>{await users.saveUser({...await users.findUserById('writer'),disabled:true} as any);h.state.beforeReply=null;};
 check('disabling owner during analysis rejects response',(await call({...bookRequest,expectedRevision:fresh!.revision})).status===403);
 await users.saveUser({...await users.findUserById('writer'),disabled:false} as any);
 h.state.beforeReply=async()=>{await h.media.deleteAsset(asset.id,'writer');h.state.beforeReply=null;};
 check('deleting private reference while AI runs rejects late response',(await call({...bookRequest,expectedRevision:fresh!.revision})).status===403);
 registerSourceRoutes(h.app,{access:{getBookOwnerId:async id=>(await books.getBook(id))?.ownerId,getCollabOwnerId:async()=>undefined,listAcceptedInvites:async()=>[],effectiveAccess:async({projectId,userId})=>{
  if(revoked||userId!=='reader')return null;const e=computeEffective(projectId,userId,[],{full:false});e.scenes.allowed='view';e.restricted=true;return e;
 }}});
 const tags='/api/core/projects/'+stored.id+'/source/tags?tags=origin:ai&status=accepted';
 r=await h.request(tags,'GET',undefined,'reader');
 check('server tag index contains only permitted scene and omits private world notes',r.status===200&&r.body.fragments.length===1&&!JSON.stringify(r.body).includes('PRIVATE_'));
 check('foreign tag query and guest are denied',(await h.request(tags,'GET',undefined,'other')).status===403&&(await h.request(tags,'GET',undefined,'guest')).status===401);
 revoked=true;check('tag index observes revoked access on next request',(await h.request(tags,'GET',undefined,'reader')).status===403);
 check('photo endpoints never create manuscripts implicitly',(await books.getBook(stored.id))!.revision===fresh!.revision);
 console.log('Підсумок: '+count+' пройшло.');
}finally{await h.close();}
