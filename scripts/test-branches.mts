const {saveBook,getBook}=await import('../server/bookStore');const {branchHash,branchCanonHash,createBranch,putBranchFragment,mergeBranchFragment,checkBranch,saveBranches,branchSnapshot}=await import('../server/core/branches');
async function suite(repo:CoreRepository){let n=0;const check=(label:string,fn:()=>void)=>{fn();n++;console.log(`✓ ${label}`);};const P=randomUUID();await repo.upsertProject({id:P,ownerId:'owner',title:'Гілки'});await repo.upsertDocument({projectId:P,id:'ch',kind:'chapter',order:0});await repo.upsertDocument({projectId:P,id:'s',parentId:'ch',kind:'section',order:0});await repo.upsertParagraph({projectId:P,id:'p',documentId:'s',text:'Оригінал.',kind:'paragraph',order:0},'system:core_sync');const actor='user:owner';const stored=await saveBook({book:{id:P,title:'Гілки',chapters:[{id:'ch',sections:[{id:'s',content:'Оригінал.'}]}]} as any,ownerId:'owner'});
const original=branchHash(stored.book),canon=await branchCanonHash(repo,P);let r=await createBranch(repo,P,stored,{name:'Альтернатива',expectedRevision:0},actor);const id=r.branch.id;
check('створення зберегло основу',()=>assert.equal(r.branch.baseBookHash,original));await assert.rejects(createBranch(repo,P,stored,{name:'Застаріла',expectedRevision:0},actor));n++;
