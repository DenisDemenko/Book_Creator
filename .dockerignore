# Ставиться заново всередині образу через npm ci — копіювати теку з
# хостової (Windows) машини і довго, і небезпечно: нативні залежності
# зібрані під іншу платформу.
node_modules/

# Збірка робиться в образі; хостовий dist/ лише зіпсував би кеш шарів.
dist/
build/

# Секрети ніколи не потрапляють в образ: у Railway вони приходять
# змінними оточення. .env.example лишаємо — він документація.
.env
.env.*
!.env.example

# Дані рантайму — на постійному томі, не в образі.
data/
assets/generated/

# Історія й локальні артефакти, що не впливають на збірку, але роздувають
# контекст і ламають кешування шарів.
.git/
.github/
*.log
coverage/
screenshots_chat/
*.pdf
photo_*.jpg
