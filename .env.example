# GEMINI_API_KEY: обов'язковий. Використовується і для текстових функцій,
# і для генерації зображень (сімейство моделей Nano Banana).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: адреса, за якою розгорнуто застосунок.
APP_URL="MY_APP_URL"

# PORT: порт HTTP-сервера. Cloud Run / Railway / Render передають його самі.
# PORT=3000

# --- Необов'язкові перевизначення моделей ---
# Текстова модель для редагування, синопсисів, оцінювання завдань.
# GEMINI_MODEL=gemini-3.7-flash

# Моделі генерації зображень. Змінюйте, коли Google випустить наступне покоління.
# NANO_BANANA_LITE_MODEL=gemini-3.1-flash-lite-image
# NANO_BANANA_MODEL=gemini-3.1-flash-image
# NANO_BANANA_PRO_MODEL=gemini-3-pro-image

# Каталог, куди складаються згенеровані зображення.
# УВАГА: на ефемерному хостингу (Cloud Run) локальний диск не переживає
# перезапуск — там варто підмінити на об'єктне сховище.
# GENERATED_IMAGES_DIR=/data/generated

# --- Автентифікація та адмінка ---
# Пошта, яка автоматично отримує роль адміністратора.
ADMIN_EMAIL="tropazemli@gmail.com"

# --- Firebase Auth (docs/migration-plan.md Фаза G1) ---
# Той самий Firebase-проєкт, що й у маркетплейсі fusion-lab — спільний
# обліковий запис і є механізмом єдиного входу між двома системами.
# Сервісний акаунт: Firebase Console → Project settings → Service accounts
# → Generate new private key (проєкт fusionlab-acc2d).
# Без цих трьох (або без FIREBASE_PRIVATE_KEY_B64 замість PEM-варіанту)
# вхід поштою/Google недоступний, а гостьовий режим працює як звичайно.
# FIREBASE_PROJECT_ID=fusionlab-acc2d
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fusionlab-acc2d.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Альтернатива PEM вище (менше шансів, що хостинг зіпсує \n і лапки):
# FIREBASE_PRIVATE_KEY_B64=

# Публічна конфігурація для клієнта (Vite вимагає префікс VITE_; значення
# не секретні — ті самі, що вже в бандлі маркетплейсу).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=fusionlab-acc2d.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=fusionlab-acc2d

# --- Єдиний домен: Nova під /studio (Фаза G3) ---
# Префікс шляху для ЗБІРКИ клієнта. Задається лише в проді, де Nova
# роздається як app.fusionlab.in.ua/studio через rewrite Next.js. Це не
# косметика: браузер тримає стан входу Firebase окремо для кожного origin,
# тож спільна сесія з маркетплейсом можлива тільки на спільному домені.
# Порожнє значення = звичайний корінь (локальна розробка).
# NOVA_BASE_PATH=/studio/

# Адреса WebSocket спільного редагування. Потрібна лише в проді: rewrite
# Vercel не проксує WebSocket, тож WS має ходити напряму на власний хост
# Nova, поки весь HTTP іде під /studio. Локально не задавати — візьметься
# хост поточної сторінки.
# VITE_NOVA_WS_URL=wss://nova.up.railway.app/ws

# --- Сховище ---
# Каталог з базою даних (і зі старими JSON-файлами, якщо вони лишилися).
# На ефемерному хостингу вкажіть постійний том, інакше дані зникнуть при рестарті.
# DATA_DIR=/data

# Шлях до файла бази SQLite. За замовчуванням <DATA_DIR>/nova-studio.db
# DATABASE_PATH=/data/nova-studio.db
#
# База працює на вбудованому модулі node:sqlite (Node 22.5+), тож окремих
# залежностей не потрібно. На старішому Node застосунок автоматично
# відкотиться на JSON-файли й повідомить про це в лозі старту.

# --- Підписка та оплата ---
# PrivatBank (LiqPay) — публічний і приватний ключ з кабінету LiqPay.
# Без них кнопка оплати картою покаже 503 із поясненням.
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=

# PayPal — REST-застосунок з developer.paypal.com. sandbox для тестів,
# live для реальних платежів. PayPal не приймає гривню, тож ціна
# конвертується в долари за курсом PAYPAL_UAH_TO_USD_RATE (тримайте
# актуальним вручну — це не курс НБУ в реальному часі).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_UAH_TO_USD_RATE=0.024

# --- Seedream (ByteDance) — альтернативний двигун зображень ---
# Ключ ARK_API_KEY (BytePlus ModelArk / Volcengine Ark) вмикає двигун
# «Seedream (ByteDance)» у списку моделей для генерації персонажів,
# ілюстрацій та обкладинок — поряд із Nano Banana (Gemini). Це саме
# Seedream (зображення), не Seedance (окрема модель ByteDance для відео,
# у NOVA STUDIO не використовується). Без ключа цей двигун просто
# позначений як недоступний, решта сайту працює як завжди.
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDREAM_MODEL=seedream-4-0-250828

# --- ШІ-текст за мотивами зображення ---
# Ключ OpenAI — потрібен лише для варіанту «GPT» у генераторі тексту
# за зображенням (Ілюстрації → кнопка під прев'ю). Варіант «Gemini»
# використовує вже наявний GEMINI_API_KEY.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Форматування готового файлу під Amazon KDP (Claude) ---
# Ключ Anthropic — потрібен для окремого інструмента «Форматування файлу»
# (доступний лише підписникам Pro/Ultra): рукопис приносять уже готовим,
# Claude структурує глави й прибирає артефакти форматування перед друком
# у KDP-сумісний PDF. Без ключа кнопка форматування покаже 503.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Мультимодельний чат-асистент (Pro/Ultra) ---
# Чат-сесії (server/chatProviders.ts) тепер вміють 6 провайдерів; модель
# обирає користувач. Кожен провайдер, чий ключ заданий, з'являється в
# селекторі чату як доступний. Без ключа відповідна модель показує
# чесну демо-відповідь. Ціну можна перевизначити через *INPUT_PRICE /
# *OUTPUT_PRICE (долари за мільйон токенів).
# DeepSeek (за замовчуванням deepseek-chat, позапікова ціна $0.22/$0.66 за млн).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_INPUT_PRICE=0.22
# DEEPSEEK_OUTPUT_PRICE=0.66
# Groq — Llama (за замовчуванням llama-3.3-70b-versatile, $0.59/$0.79 за млн).
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_INPUT_PRICE=0.59
# GROQ_OUTPUT_PRICE=0.79
# Mistral (за замовчуванням mistral-large-latest, $0.5/$1.5 за млн).
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_INPUT_PRICE=0.5
# MISTRAL_OUTPUT_PRICE=1.5

# --- Публікація на Etsy (модуль «Публікація та експорт») ---
# Ключі з Etsy Developer Portal (developers.etsy.com). Без них KDP-гілка
# модуля (файли, розрахунок корінця, лист метаданих) і пакувальник набору
# працюють як звичайно, а Etsy-гілка показує пояснення, чого бракує.
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=

# Redirect URI, зареєстрований у кабінеті розробника Etsy. Якщо не задати,
# збереться як <APP_URL>/api/etsy/oauth/callback.
# ETSY_REDIRECT_URI=

# Ключ шифрування токенів Etsy у базі (AES-256-GCM). Будь-яка довга парольна
# фраза. Якщо не заданий — використовується ETSY_SHARED_SECRET.
# УВАГА: зміна цього значення робить уже збережені токени нечитаними —
# авторам доведеться підключити крамницю ще раз.
# ETSY_TOKEN_SECRET=

# Ліміт швидкості звернень до Etsy. Стеля платформи — 10 запитів/сек на
# застосунок; тримаємо трохи нижче, щоб кілька авторів не штовхали одне одного.
# ETSY_RATE_LIMIT_PER_SECOND=8

# Скільки годин вважати збережений зріз дослідження теми свіжим (24–72).
# ETSY_RESEARCH_CACHE_HOURS=24

# Як часто фоново оновлювати вже досліджені теми, хвилин. 0 — не оновлювати
# (тоді «динаміка попиту» показуватиме лише ті дні, коли автор шукав сам).
# ETSY_RESEARCH_REFRESH_MINUTES=0

# Шрифт для README.pdf у наборі курсу. Стандартні шрифти PDF не підтримують
# кирилиці, тож без Unicode-шрифту README вкладається як .txt.
# ETSY_README_FONT_PATH=/data/fonts/DejaVuSans.ttf
# ETSY_README_FONT_URL=

# --- Gamma — ВИМКНЕНО (рішення власника 05.09.2026) ---
# Рушій знято з реєстрації в server/pdf/engines/registry.ts: він переписував
# рукопис замість верстати його, а платив за це автор кредитами власної
# підписки. Ключ нижче ні на що не впливає, доки рушій не повернуть.
# Опис лишається, щоб не з'ясовувати ці межі вдруге.
#
# Ключ Gamma Generate API вмикає рушій «Gamma» у Хабі публікації поряд із
# двома власними. Видається в кабінеті Gamma і працює лише на тарифах Pro,
# Ultra, Teams або Business — на безкоштовному ключ буває валідним, а виклик
# усе одно відмовляє (403). Без ключа маршрути /api/gamma/* віддають 503 із
# поясненням, решта Студії працює як завжди.
#
# Ключ тут — спільний для всіх авторів, і кожна генерація списує кредити з
# рахунку ВЛАСНИКА студії. Автор може натомість ввести власний ключ у самій
# Студії — той шифрується в таблиці user_api_keys і має пріоритет.
#
# Межа самого API: окремої генерації ЗОБРАЖЕНЬ у публічному Gamma API немає
# (лише в MCP-конекторі), тож обкладинку цим шляхом не зробити — картинки
# народжуються тільки всередині генерації документа.
# GAMMA_API_KEY=
# GAMMA_API_BASE=https://public-api.gamma.app/v1.0
# GAMMA_RATE_LIMIT_PER_SECOND=2
# GAMMA_POLL_INTERVAL_MS=5000
# GAMMA_MAX_WAIT_MS=600000
