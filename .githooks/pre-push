#!/bin/sh
#
# Перед пушем: кожне посилання «#N» у комітах, які їдуть на remote, має
# вести на запис журналу, який парсер СПРАВДІ знаходить.
#
# Чому саме перед пушем, а не перед комітом: локальна історія — робоче
# місце, там нормально мати недописаний запис посеред роботи. А от те, що
# поїхало на remote, читає власник у схемі комітів в адмінці, і бейдж, що
# веде в порожнечу, — це вже його проблема, не моя.
#
# Хук НЕ перевіряє стиль, обсяг чи наявність запису на кожен коміт: запис
# на кожен коміт і не потрібен (їх 151 на 211 комітів). Перевіряється лише
# цілісність зв'язку — рівно та помилка, що сталась 12.09.2026, коли
# парсер знав одну конвенцію заголовків із трьох.
#
# Увімкнути один раз у клоні:  git config core.hooksPath .githooks
# Обійти в разовому випадку:   git push --no-verify

set -e

# Порожній хеш = гілку видаляють; перевіряти нічого.
ZERO='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # Нова гілка на remote — беремо всі її коміти, яких ще немає деінде.
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if ! npx tsx scripts/journal-check.mts "$range"; then
    echo ""
    echo "pre-push: пуш скасовано. Обійти разово — git push --no-verify"
    exit 1
  fi
done

exit 0
