# Скопіюйте в .env (його створює scripts/start). У git .env не потрапляє.

# Адреса Studio. https обов'язково (http дозволено лише для localhost / host.docker.internal під час локальної перевірки).
STUDIO_URL=https://www.fusionlab.in.ua/studio

# Одноразовий код підключення з адмінпанелі Studio (вкладка «Локальні сервери»). Видається ЛИШЕ після підтвердження поштою й
# кодом, діє 15 хвилин. Після успішного підключення код можна прибрати з файлу.
PAIRING_CODE=

# Порт на цьому комп'ютері (публікується лише на 127.0.0.1) і адреса, за якою до сервера звертається браузер.
PRIVATE_STORE_PORT=8787
PRIVATE_STORE_PUBLIC_URL=http://127.0.0.1:8787

# Назва, яку побачить адміністратор у Studio.
PRIVATE_STORE_NAME=Мій локальний сервер
