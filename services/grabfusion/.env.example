# Адреса API Studio (без завершального слеша)
GRABFUSION_STUDIO_URL=https://fusionlab.in.ua/api/external/v1
# Токен nst_… сервіс отримує обміном коду підключення (POST /pair) і тримає в сесії; у браузер він не потрапляє.
# Публічний каталог маркетплейсу (лише читання, без ключа)
GRABFUSION_MARKET_URL=https://fusionlab.in.ua
# Для розробки без Studio: адреса мок-сервера, напр. http://127.0.0.1:8765/api/external/v1
GRABFUSION_HOST=127.0.0.1
GRABFUSION_PORT=8000
# Сховище сесій (cookie → токен Studio), SQLite. На сервері — шлях на постійному диску
GRABFUSION_SESSION_DB=grabfusion.sqlite3
# 1 за HTTPS (cookie лише по захищеному каналу)
GRABFUSION_COOKIE_SECURE=0
